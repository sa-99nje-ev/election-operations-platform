# ==============================================================================
# Election Operations Platform - Environment Configuration
# ==============================================================================
#
# This file documents all required and optional environment variables for the
# Election Operations Platform. Copy this file to .env and fill in your values.
#
# IMPORTANT: Never commit the .env file to version control!
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application Configuration
# ------------------------------------------------------------------------------

# Application environment: development, testing, or production
# Determines which configuration profile to load
# Default: development
FLASK_ENV=development

# Flask secret key for session management and CSRF protection
# REQUIRED: Generate a strong random key (e.g., using `openssl rand -hex 32`)
# Example: a3f8c9d2e5b7a4f1c8d6e3b9a2f5c8d1e7b4a9c2f5d8e1b7a4c9f2d5e8b1a4c7
SECRET_KEY=your-secret-key-change-this

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------

# PostgreSQL connection URL
# REQUIRED: Full connection string including credentials and database name
# Format: postgresql://username:password@host:port/database
# Example: postgresql://election_user:secure_password@localhost:5432/election_db
DATABASE_URL=postgresql://election_user:secure_password@localhost:5432/election_db

# Individual database connection parameters (alternative to DATABASE_URL)
# These are used to construct DATABASE_URL if not provided directly
DB_USER=election_user
DB_PASSWORD=secure_password_change_this
DB_HOST=localhost
DB_PORT=5432
DB_NAME=election_db

# Database connection pool settings
# Number of connections to maintain in the pool (default: 5)
DB_POOL_SIZE=5

# Connection recycle time in seconds to prevent stale connections (default: 3600)
DB_POOL_RECYCLE=3600

# Enable SQL query logging (useful for debugging, disable in production)
# Options: True or False (default: False)
SQLALCHEMY_ECHO=False

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------

# Redis connection URL for task queue and caching
# REQUIRED: Full connection string including host and port
# Format: redis://host:port/db_number
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis port (if running locally)
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------

# Secret key for signing JWT tokens
# REQUIRED: Generate a strong random key (different from SECRET_KEY)
# Example: b8e4d2f9c1a6e3d7b5a9c2f8e4d1a7c3e6b9d2a5f8c1e7b4d9a2c5f8e1b7a4c
JWT_SECRET_KEY=your-jwt-secret-change-this

# JWT access token expiration time in seconds
# Recommendation: 900 seconds (15 minutes) for security
# Default: 900
JWT_ACCESS_TOKEN_EXPIRES=900

# JWT refresh token expiration time in seconds
# Recommendation: 604800 seconds (7 days) for convenience
# Default: 604800
JWT_REFRESH_TOKEN_EXPIRES=604800

# ------------------------------------------------------------------------------
# Celery (Async Task Queue) Configuration
# ------------------------------------------------------------------------------

# Celery broker URL (message queue for task distribution)
# If not specified, defaults to REDIS_URL
# Format: redis://host:port/db_number
# Example: redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (stores task results)
# If not specified, defaults to REDIS_URL
# Format: redis://host:port/db_number
# Example: redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Number of concurrent worker processes per Celery worker instance
# Recommendation: Number of CPU cores or slightly higher
# Default: 4
CELERY_WORKER_CONCURRENCY=4

# Maximum time (seconds) a task can run before being killed
# Default: 30
CELERY_TASK_TIME_LIMIT=30

# Number of tasks to prefetch per worker
# Lower values = more fair distribution, higher values = better throughput
# Default: 1 (fair distribution)
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ------------------------------------------------------------------------------
# Service Port Configuration
# ------------------------------------------------------------------------------

# Port for the Flask API server
# Default: 5000
API_PORT=5000

# Port for the Plotly Dash dashboard
# Default: 8050
DASHBOARD_PORT=8050

# Port for the Locust load testing web UI
# Default: 8089
LOCUST_PORT=8089

# Port for PostgreSQL (when running in Docker)
# Default: 5432
DB_PORT=5432

# ------------------------------------------------------------------------------
# Election Day Configuration
# ------------------------------------------------------------------------------

# Election start time in ISO 8601 format (UTC)
# Example: 2024-01-15T08:00:00Z (8:00 AM UTC on January 15, 2024)
# OPTIONAL: If not set, polling booths can be opened at any time
ELECTION_START_TIME=2024-01-15T08:00:00Z

# Election end time in ISO 8601 format (UTC)
# Example: 2024-01-15T18:00:00Z (6:00 PM UTC on January 15, 2024)
# OPTIONAL: If not set, polling booths can be closed at any time
ELECTION_END_TIME=2024-01-15T18:00:00Z

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------

# Default page size for paginated API responses
# Default: 20
DEFAULT_PAGE_SIZE=20

# Maximum page size for paginated API responses
# Default: 100
MAX_PAGE_SIZE=100

# Number of retry attempts for audit log writes
# Default: 3
AUDIT_LOG_RETRY_ATTEMPTS=3

# Delay between audit log retry attempts in seconds
# Default: 1
AUDIT_LOG_RETRY_DELAY=1

# ------------------------------------------------------------------------------
# Testing Configuration (Optional)
# ------------------------------------------------------------------------------

# Database URL for testing environment
# If not specified, uses DATABASE_URL
# Recommendation: Use a separate test database
# Example: postgresql://test_user:test_pass@localhost:5432/election_test_db
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/election_test_db

# ------------------------------------------------------------------------------
# Docker Compose Configuration (Optional)
# ------------------------------------------------------------------------------

# Docker-specific environment variables used by docker-compose.yml
# These override the above settings when running in containers

# PostgreSQL credentials for Docker container
POSTGRES_USER=election_user
POSTGRES_PASSWORD=secure_password_change_this
POSTGRES_DB=election_db

# ------------------------------------------------------------------------------
# Security Recommendations
# ------------------------------------------------------------------------------
#
# 1. Generate strong random keys for SECRET_KEY and JWT_SECRET_KEY:
#    $ openssl rand -hex 32
#
# 2. Use different keys for SECRET_KEY and JWT_SECRET_KEY
#
# 3. Never commit .env to version control (add to .gitignore)
#
# 4. Use strong database passwords (minimum 16 characters, mixed case, numbers, symbols)
#
# 5. In production:
#    - Set FLASK_ENV=production
#    - Use environment variables instead of .env file
#    - Rotate keys regularly (at least annually)
#    - Enable SSL for database connections
#    - Use secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# 6. Restrict database user permissions (principle of least privilege)
#
# 7. Enable database connection encryption (SSL/TLS)
#
# ------------------------------------------------------------------------------
# Quick Start
# ------------------------------------------------------------------------------
#
# 1. Copy this file to .env:
#    $ cp .env.example .env
#
# 2. Generate secret keys:
#    $ openssl rand -hex 32  # For SECRET_KEY
#    $ openssl rand -hex 32  # For JWT_SECRET_KEY
#
# 3. Update .env with your values:
#    - Replace SECRET_KEY with generated key
#    - Replace JWT_SECRET_KEY with generated key
#    - Update database credentials if needed
#
# 4. Start the application:
#    $ docker compose up
#
# ------------------------------------------------------------------------------
